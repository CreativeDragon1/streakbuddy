{
    "display_information": {
        "name": "streaksaver",
        "description": "a bot to save yo streaks",
        "background_color": "#000000"
    },
    "features": {
        "bot_user": {
            "display_name": "streaksaver",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/streaksaver-ping",
                "description": "pings the bot",
                "usage_hint": "to test",
                "should_escape": false
            },
            {
                "command": "/streaksaver-help",
                "description": "need help?",
                "should_escape": false
            },
            {
                "command": "/streaksaver-set_goal",
                "description": "Set your goal for today",
                "should_escape": false
            },
            {
                "command": "/streaksaver-get_goal",
                "description": "gets your goal for the day",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "commands",
                "channels:history",
                "app_mentions:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}